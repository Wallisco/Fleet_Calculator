# ── HubSpot ───────────────────────────────────────────────────────────────
# Private app token, portal 148678580 (EU1 — token starts pat-eu1-)
# Scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#         crm.schemas.contacts.read, crm.schemas.contacts.write, files
HUBSPOT_TOKEN=pat-eu1-xxxxxxxxxxxx
HUBSPOT_FOLDER=/calculator-proposals

# ── Resend ────────────────────────────────────────────────────────────────
# scoothero.co.za must be verified in Resend (SPF + DKIM) before sending
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM=ScootHero <proposals@scoothero.co.za>
MAIL_REPLY_TO=sales@scoothero.co.za
SALES_INBOX=wahlied@scoothero.co.za,dewald@scoothero.co.za

# ── Site ──────────────────────────────────────────────────────────────────
BOOKING_URL=https://fleet.scoothero.co.za/demo.html
# Only needed if the calculator is embedded on another domain. The site and API
# are same-origin on fleet.scoothero.co.za, so this is a fallback.
ALLOWED_ORIGINS=https://fleet.scoothero.co.za,https://scoothero.co.za,https://www.scoothero.co.za
