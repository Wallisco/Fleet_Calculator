<!DOCTYPE html>
<html lang="en-ZA">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Fleet operator savings — ScootHero</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --navy:#0A0F23; --navy-2:#141B36; --orange:#F26700; --orange-dk:#C85400;
  --mint:#79F1A1; --leaf:#DFFBCB; --ink:#0A0F23; --muted:#5A5F73;
  --line:#E3E5EC; --surface:#F4F5F7; --white:#fff; --warn:#FAECE7; --warn-ink:#993C1D; --r:14px;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{font-family:'Poppins',system-ui,sans-serif;color:var(--ink);background:var(--white);-webkit-font-smoothing:antialiased;line-height:1.5}
.wrap{max-width:1080px;margin:0 auto;padding:28px 20px 40px}
h1,h2,h3{font-family:'Lexend',system-ui,sans-serif;font-weight:600;letter-spacing:-.01em;margin:0}
.eyebrow{font-family:'Lexend',sans-serif;font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--orange);margin:0 0 8px}
.lede{color:var(--muted);font-size:15px;max-width:62ch;margin:10px 0 0}
.head{border-bottom:1px solid var(--line);padding-bottom:22px;margin-bottom:26px}
.head h1{font-size:clamp(26px,4vw,38px);line-height:1.12}

/* controls */
.panel{background:var(--surface);border-radius:var(--r);padding:20px}
.ctrl-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:20px}
.field label,.flabel{display:block;font-family:'Lexend',sans-serif;font-size:12px;font-weight:600;color:var(--ink);margin-bottom:8px}
.hint{font-size:11.5px;color:var(--muted);margin-top:6px;line-height:1.45}
.hint b{color:var(--ink);font-family:'Lexend',sans-serif;font-weight:500}

.stepper{display:flex;background:var(--white);border:1px solid var(--line);border-radius:10px;overflow:hidden;max-width:190px}
.stepper button{width:44px;border:0;background:var(--white);font-size:20px;color:var(--orange);cursor:pointer;font-family:'Lexend',sans-serif;line-height:1}
.stepper button:hover{background:var(--leaf)}
.stepper input{flex:1;border:0;text-align:center;font-family:'Lexend',sans-serif;font-size:20px;font-weight:600;color:var(--ink);width:100%;padding:10px 0;background:transparent}
.stepper input:focus{outline:2px solid var(--orange);outline-offset:-2px}

.fixed-val{display:flex;align-items:center;background:var(--surface);border:1px solid var(--line);
  border-radius:10px;max-width:190px;padding:10px 13px;font-family:'Lexend',sans-serif;
  font-size:20px;font-weight:600;color:var(--ink)}
.rand{display:flex;align-items:center;background:var(--white);border:1px solid var(--line);border-radius:10px;overflow:hidden;max-width:190px}
.rand .pre{padding:0 4px 0 13px;font-family:'Lexend',sans-serif;font-size:18px;font-weight:600;color:var(--muted)}
.rand input{flex:1;border:0;font-family:'Lexend',sans-serif;font-size:20px;font-weight:600;color:var(--ink);width:100%;padding:10px 12px 10px 2px;background:transparent}
.rand input:focus{outline:2px solid var(--orange);outline-offset:-2px}

.seg{display:flex;flex-wrap:wrap;gap:6px}
.seg button{flex:1 1 auto;min-width:96px;padding:10px 12px;border:1px solid var(--line);background:var(--white);border-radius:10px;cursor:pointer;font-family:'Lexend',sans-serif;font-size:12.5px;font-weight:500;color:var(--muted);transition:background .15s,color .15s,border-color .15s}
.seg button:hover{border-color:var(--orange)}
.seg button[aria-pressed="true"]{background:var(--navy);border-color:var(--navy);color:var(--white)}
.seg button:focus-visible{outline:2px solid var(--orange);outline-offset:2px}

details.adv{margin-top:18px;border-top:1px solid var(--line);padding-top:16px}
details.adv summary{cursor:pointer;font-family:'Lexend',sans-serif;font-size:12.5px;font-weight:600;color:var(--orange);list-style:none}
details.adv summary::-webkit-details-marker{display:none}
details.adv summary::before{content:"+ ";font-weight:700}
details.adv[open] summary::before{content:"– "}
.adv-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px;margin-top:16px}
.adv-grid input{width:100%;padding:9px 11px;border:1px solid var(--line);border-radius:9px;font-family:'Poppins',sans-serif;font-size:14px;color:var(--ink);background:var(--white)}
.adv-grid input:focus{outline:2px solid var(--orange);outline-offset:-1px}
.adv-grid .flabel{font-size:11.5px;font-weight:500}
.adv-note{display:block;margin-top:5px;font-size:11px;color:var(--muted);font-style:italic}
.petrol-h{margin:20px 0 0;padding-top:16px;border-top:1px solid var(--line);font-family:'Lexend',sans-serif;font-size:12px;font-weight:600;color:var(--ink)}
.petrol-h em{font-weight:400;font-style:italic;color:var(--muted)}
.is-hidden{display:none!important}

/* flow bar */
.flow{margin:34px 0 0}
.flow-head{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px;margin-bottom:14px}
.flow-head h2{font-size:17px}
.flow-total{font-family:'Lexend',sans-serif;font-size:13px;color:var(--muted)}
.flow-total b{color:var(--ink);font-size:16px}
.bar{display:flex;height:62px;border-radius:12px;overflow:hidden;background:var(--surface);border:1px solid var(--line)}
.seg-b{display:flex;flex-direction:column;justify-content:center;padding:0 12px;min-width:0;transition:flex-basis .45s cubic-bezier(.4,0,.2,1)}
.seg-b .sl{font-size:10.5px;font-family:'Lexend',sans-serif;font-weight:600;letter-spacing:.04em;text-transform:uppercase;opacity:.85;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.seg-b .sv{font-family:'Lexend',sans-serif;font-size:15px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.b-loss{background:#E8EAEF;color:#6C7185}
.b-serv{background:var(--navy-2);color:#C9CEE0}
.b-dist{background:#243055;color:#C9CEE0}
.b-fuel{background:#243055;color:#C9CEE0}
.b-fin{background:#3B4468;color:#DCE0EC}
.b-marg{background:var(--orange);color:#fff}
.bar-key{display:flex;flex-wrap:wrap;gap:16px;margin-top:12px;font-size:11.5px;color:var(--muted)}
.bar-key span{display:flex;align-items:center;gap:6px}
.compare{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}
.cmp{border-radius:10px;padding:14px 16px}
.cmp .cl{display:block;font-family:'Lexend',sans-serif;font-size:11px;font-weight:600;letter-spacing:.07em;text-transform:uppercase}
.cmp .cv{display:block;font-family:'Lexend',sans-serif;font-size:26px;font-weight:600;line-height:1.15;margin:5px 0 4px;letter-spacing:-.02em}
.cmp small{display:block;font-size:11.5px;line-height:1.45}
.cmp-us{background:var(--navy)}
.cmp-us .cl{color:var(--mint)}
.cmp-us .cv{color:#fff}
.cmp-us small{color:#9AA0B4}
.cmp-them{background:var(--surface);border:1px solid var(--line)}
.cmp-them .cl{color:var(--muted)}
.cmp-them .cv{color:var(--ink)}
.cmp-them small{color:var(--muted)}
@media (max-width:620px){.compare{grid-template-columns:1fr}}
.batt{margin:12px 0 0;padding:11px 14px;border-radius:9px;background:var(--leaf);color:#1E5B2A;font-size:12.5px;line-height:1.5}
.batt b{font-family:'Lexend',sans-serif;font-weight:600}
.dot{width:9px;height:9px;border-radius:3px;flex:0 0 auto}

/* results */
.results{background:var(--navy);border-radius:var(--r);padding:26px;margin-top:34px;color:#fff}
.results h2{color:#fff;font-size:19px;margin-bottom:4px}
.results .sub{color:#9AA0B4;font-size:12.5px;margin-bottom:22px}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:14px}
.kpi{background:var(--navy-2);border:1px solid #2A3354;border-radius:11px;padding:15px 16px}
.kpi .k{font-family:'Lexend',sans-serif;font-size:10.5px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--mint);margin-bottom:7px}
.kpi .v{font-family:'Lexend',sans-serif;font-size:25px;font-weight:600;line-height:1.1;letter-spacing:-.02em}
.kpi .s{font-size:11.5px;color:#9AA0B4;margin-top:5px;line-height:1.4}

/* hero ROI block */
.roi{margin-top:16px;background:var(--orange);border-radius:12px;padding:20px 24px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
.roi .rk{font-family:'Lexend',sans-serif;font-size:13px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#fff;opacity:.92}
.roi .rs{font-size:14px;color:#FFE9D8;margin-top:7px;max-width:46ch;line-height:1.45}
.roi .rv{font-family:'Lexend',sans-serif;font-size:clamp(34px,6vw,46px);font-weight:700;line-height:1;letter-spacing:-.03em;color:#fff;white-space:nowrap}

.lev{margin:16px 0 0;padding:13px 15px;border-radius:10px;background:#2A2010;border:1px solid #5A431A;color:#F3D9A8;font-size:12.5px;line-height:1.5}
.lev b{font-family:'Lexend',sans-serif;color:#FFC46B;font-weight:600}

.horizon{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:16px}
.hz{background:var(--navy-2);border:1px solid #2A3354;border-radius:11px;padding:18px 20px}
.hz .hzt{font-family:'Lexend',sans-serif;font-size:12px;font-weight:600;color:#fff;margin-bottom:12px;padding-bottom:10px;border-bottom:1px solid #2A3354}
.hz .row{display:flex;justify-content:space-between;gap:10px;font-size:13px;padding:5px 0;color:#C4C9DA}
.hz .row b{font-family:'Lexend',sans-serif;color:#fff;font-weight:500;font-variant-numeric:tabular-nums}
.hz .row.tot{border-top:1px solid #2A3354;margin-top:8px;padding-top:10px}
.hz .row.tot b{color:var(--mint);font-size:16px}

/* benefits */
.bens{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;margin-top:16px}
.ben{border:1px solid var(--line);border-radius:12px;padding:16px 18px;background:#fff;position:relative}
.ben::before{content:"";position:absolute;left:0;top:16px;bottom:16px;width:3px;border-radius:0 3px 3px 0;background:var(--mint)}
.bt{font-family:'Lexend',sans-serif;font-size:14px;font-weight:600;color:var(--ink);margin-bottom:6px}
.bd{font-size:12.5px;color:var(--muted);line-height:1.5}

/* one-price band */
.oneprice{margin-top:16px;background:var(--navy);border-radius:12px;padding:20px 22px}
.op-items{display:grid;grid-template-columns:repeat(auto-fit,minmax(215px,1fr));gap:14px 18px}
.op-item{display:flex;align-items:center;gap:11px;color:#fff;font-family:'Lexend',sans-serif;font-size:13.5px;font-weight:500;line-height:1.35}
.op-item svg{width:26px;height:26px;flex:0 0 auto;color:var(--mint)}
.op-line{margin:16px 0 0;padding-top:14px;border-top:1px solid #2A3354;font-size:13.5px;color:#C4C9DA}
.op-line b{color:var(--orange);font-family:'Lexend',sans-serif;font-weight:600}

/* process chart */
.proc{margin-top:34px}
.proc-phase{margin-top:20px}
.proc-lbl{display:flex;align-items:center;gap:12px;font-family:'Lexend',sans-serif;font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:12px}
.proc-lbl::after{content:"";flex:1;height:1px;background:var(--line)}
.proc-lbl .tag{background:var(--leaf);color:#1E5B2A;border-radius:99px;padding:3px 10px;letter-spacing:.06em}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
.step{border:1px solid var(--line);border-radius:12px;padding:16px 18px;position:relative;background:var(--white)}
.step .n{font-family:'Lexend',sans-serif;font-size:11px;font-weight:700;color:var(--orange);letter-spacing:.1em;margin-bottom:7px}
.step .t{font-family:'Lexend',sans-serif;font-size:14px;font-weight:600;line-height:1.3;margin-bottom:6px}
.step .d{font-size:12.5px;color:var(--muted);line-height:1.5}
.step .val{margin-top:10px;padding-top:10px;border-top:1px solid var(--line);font-family:'Lexend',sans-serif;font-size:17px;font-weight:600;font-variant-numeric:tabular-nums}
.step .val small{display:block;font-family:'Poppins',sans-serif;font-size:11px;font-weight:400;letter-spacing:0;margin-top:2px}
.step:not(:last-child)::after{
  content:"";position:absolute;top:50%;right:-19px;width:12px;height:12px;
  border-top:2px solid #C9CCD6;border-right:2px solid #C9CCD6;transform:translateY(-50%) rotate(45deg);
}
.steps.wk .step{background:var(--navy);border-color:var(--navy);color:#fff}
.steps.wk .step .d{color:#9AA0B4}
.steps.wk .step .val{border-top-color:#2A3354;color:var(--mint)}
.steps.wk .step .val small{color:#9AA0B4}
.steps.wk .step:not(:last-child)::after{border-color:#3B4468}
.proc-loop{margin-top:12px;font-size:12px;color:var(--muted);display:flex;align-items:center;gap:8px}
.proc-loop b{font-family:'Lexend',sans-serif;color:var(--ink);font-weight:500}

@media (max-width:760px){
  .steps{grid-template-columns:1fr;gap:22px}
  .step:not(:last-child)::after{top:auto;bottom:-17px;right:50%;transform:translateX(50%) rotate(135deg)}
}

/* tables */
.sec{margin-top:38px}
.sec h2{font-size:20px}
.tbl-scroll{overflow-x:auto;margin-top:14px;-webkit-overflow-scrolling:touch}
table{width:100%;border-collapse:collapse;min-width:600px}
th,td{text-align:left;padding:12px 14px;font-size:13px;border-bottom:1px solid var(--line)}
th{font-family:'Lexend',sans-serif;font-size:11px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);background:var(--surface)}
th:first-child{border-radius:9px 0 0 0}
th:last-child{border-radius:0 9px 0 0}
td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}
tr.on td{background:#FFF4EC;font-weight:500}
tr.on td:first-child{box-shadow:inset 3px 0 0 var(--orange)}
.pill[hidden]{display:none}
.pill{display:inline-block;font-family:'Lexend',sans-serif;font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;padding:3px 8px;border-radius:99px;background:var(--leaf);color:#1E5B2A;margin-left:8px}

/* risks */
.risks{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:14px;margin-top:16px}
.risk{border:1px solid var(--line);border-radius:12px;overflow:hidden;display:flex;flex-direction:column}
.risk .rt{background:var(--warn);color:var(--warn-ink);padding:13px 15px}
.risk .rt .rl{font-family:'Lexend',sans-serif;font-size:10px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;opacity:.8}
.risk .rt .rn{font-family:'Lexend',sans-serif;font-size:14px;font-weight:600;margin-top:3px}
.risk .rb{padding:13px 15px;font-size:12.5px;flex:1}
.risk .rb .fx{display:block;font-family:'Lexend',sans-serif;font-size:10px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:#0F6E56;margin-bottom:5px}
.risk .rq{background:var(--surface);padding:9px 15px;font-size:11.5px;color:var(--muted);border-top:1px solid var(--line)}

/* capture */
.capture{margin-top:36px;background:var(--surface);border-radius:var(--r);padding:26px}
.capture h2{font-size:19px}
.capture .lede{margin-bottom:18px}
.cap-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px}
.cap-grid label{display:block;font-family:'Lexend',sans-serif;font-size:11.5px;font-weight:600;margin-bottom:6px}
.cap-grid input{width:100%;padding:11px 13px;border:1px solid var(--line);border-radius:9px;font-family:'Poppins',sans-serif;font-size:14px;color:var(--ink);background:var(--white)}
.cap-grid input:focus{outline:2px solid var(--orange);outline-offset:-1px}
.cap-grid input[aria-invalid="true"]{border-color:#C0392B}
.consent{display:flex;gap:10px;align-items:flex-start;margin-top:16px;font-size:12.5px;color:var(--muted);line-height:1.5}
.consent input{margin-top:2px;width:17px;height:17px;accent-color:var(--orange);flex:0 0 auto}
.cap-actions{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:18px}
.btn-ghost{background:transparent;border:1px solid var(--line);color:var(--ink);border-radius:10px;padding:13px 20px;font-family:'Lexend',sans-serif;font-size:13.5px;font-weight:500;cursor:pointer}
.btn-ghost:hover{border-color:var(--orange);color:var(--orange)}
.btn[disabled]{opacity:.55;cursor:not-allowed}
.cap-msg{font-size:13px;margin-top:14px;padding:12px 14px;border-radius:9px;display:none}
.cap-msg.ok{display:block;background:var(--leaf);color:#1E5B2A}
.cap-msg.bad{display:block;background:var(--warn);color:var(--warn-ink)}
.hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}

/* extras + quote */
.opts{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;margin-top:16px}
.opt{display:flex;gap:12px;align-items:flex-start;padding:15px 16px;border:1px solid var(--line);border-radius:12px;background:#fff;cursor:pointer;transition:border-color .15s,background .15s}
.opt:hover{border-color:var(--orange)}
.opt input{margin-top:2px;width:18px;height:18px;accent-color:var(--orange);flex:0 0 auto;cursor:pointer}
.opt:has(input:checked){border-color:var(--orange);background:#FFF8F3}
.ot{display:block;font-family:'Lexend',sans-serif;font-size:13.5px;font-weight:600;color:var(--ink)}
.ot em{display:block;font-style:normal;font-size:12px;font-weight:500;color:var(--orange);margin-top:3px}
.od{display:block;font-size:12px;color:var(--muted);line-height:1.5;margin-top:6px}
.quote{margin-top:18px;background:var(--surface);border-radius:12px;padding:20px 22px}
.qt{font-family:'Lexend',sans-serif;font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--orange);margin-bottom:12px}
.qrow{display:flex;justify-content:space-between;gap:12px;padding:8px 0;font-size:13.5px;border-bottom:1px solid var(--line)}
.qrow b{font-family:'Lexend',sans-serif;font-weight:500;font-variant-numeric:tabular-nums}
.qrow.qtot{border-bottom:0;border-top:2px solid var(--navy);margin-top:6px;padding-top:12px;font-size:15px}
.qrow.qtot b{font-size:19px;font-weight:600;color:var(--navy)}
.qnote{margin:12px 0 0;font-size:11.5px;color:var(--muted)}

.popia{font-size:11.5px;color:var(--muted);line-height:1.55;margin:0 0 14px}
.popia a{color:var(--orange)}
.notice{background:#FFF8E8;border:1px solid #E8D9A8;border-radius:10px;padding:12px 14px;font-size:12.5px;color:#6B5416;line-height:1.5;margin:16px 0 0}
.notice b{font-family:'Lexend',sans-serif;font-weight:600}
.foot a{color:var(--orange)}

/* cta */
.cta{margin-top:36px;background:var(--navy);border-radius:var(--r);padding:26px;display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}
.cta h2{color:#fff;font-size:19px}
.cta p{color:#9AA0B4;font-size:13px;margin:6px 0 0;max-width:52ch}
.btn{background:var(--orange);color:#fff;border:0;border-radius:10px;padding:14px 26px;font-family:'Lexend',sans-serif;font-size:14px;font-weight:600;cursor:pointer;text-decoration:none;display:inline-block;transition:background .15s}
.btn:hover{background:var(--orange-dk)}
.btn:focus-visible{outline:2px solid var(--mint);outline-offset:3px}
.foot{margin-top:26px;font-size:11px;color:var(--muted);line-height:1.6;border-top:1px solid var(--line);padding-top:16px}

@media (max-width:760px){
  .horizon{grid-template-columns:1fr}
}
@media (max-width:620px){
  .bar{height:auto;flex-direction:column}
  .seg-b{flex-basis:auto!important;padding:10px 12px;flex-direction:row;justify-content:space-between;align-items:center;gap:10px}
  .seg-b .sl{font-size:11px}
  .roi{flex-direction:column;align-items:flex-start;gap:10px}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
</head>
<body>

<div class="wrap">

  <header class="head">
    <p class="eyebrow">Fleet operator savings</p>
    <h1>The driver deal, in numbers</h1>
    <p class="lede">Your rider saves the fuel bill. That saving is what lets you charge a higher weekly rental — as long as the rider still comes out ahead. Set the pump price and your rentals to see where the deal lands.</p>
  </header>

  <section class="panel" aria-label="Your inputs">
    <div class="ctrl-grid">
      <div class="field">
        <label for="bikes">How many bikes</label>
        <div class="stepper">
          <button type="button" id="minus" aria-label="One fewer">−</button>
