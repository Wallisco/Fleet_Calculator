<script src="model.js"></script>
<script>
(function () {
  "use strict";
  var SH = window.SHModel, R = SH.money, RC = SH.moneyC, pct = SH.percent;
  var $ = function (id) { return document.getElementById(id); };
  function num(id, fb) { var v = parseFloat($(id).value); return isFinite(v) ? v : fb; }

  // build the seven day inputs from the model's market defaults
  var dayInputs = [];
  (function buildDays() {
    var g = $('dayGrid');
    g.innerHTML = SH.DAY_NAMES.map(function (d, i) {
      return '<div><span class="flabel">' + d + ' (km)</span>' +
             '<input id="d' + i + '" type="number" min="0" max="1000" step="5" value="' +
             SH.SAVINGS_DEFAULTS.days[i] + '" aria-label="' + d + ' kilometres"></div>';
    }).join('');
    for (var i = 0; i < 7; i++) dayInputs.push($('d' + i));
  })();

  function raw() {
    return {
      bikes: num('bikes', 10),
      fuelPrice: num('fuel', 25.34),
      kmPerLitre: 30,
      electricPerKm: num('elec', 0.62),
      petrolRental: num('prental', 700),
      days: dayInputs.map(function (el) { return parseFloat(el.value) || 0; })
    };
  }

  function render() {
    var m = SH.computeSavings(raw());

    $('fuelHint').innerHTML = 'per litre — that is <b>' + RC(m.petrolPerKm) + ' a km</b> at ' + m.inputs.kmPerLitre + ' km/l';
    $('kmNote').innerHTML = 'Your riders cover <b>' + m.weeklyKm.toFixed(0) + ' km a week</b> on these figures.';

    // day table
    $('dayBody').innerHTML = m.rows.map(function (r) {
      return '<tr><td>' + r.day + '</td><td class="num">' + r.km.toFixed(0) +
             '</td><td class="num">' + R(r.petrol) + '</td><td class="num">' + R(r.electric) +
             '</td><td class="num">' + R(r.saving) + '</td></tr>';
    }).join('') +
      '<tr class="on"><td><b>Week</b></td><td class="num"><b>' + m.weeklyKm.toFixed(0) +
      '</b></td><td class="num"><b>' + R(m.petrolFuelWk) + '</b></td><td class="num"><b>' +
      R(m.electricEnergyWk) + '</b></td><td class="num"><b>' + R(m.energySaving) + '</b></td></tr>';

    $('cvE').textContent = R(m.driverElectricWk);
    $('cvP').textContent = R(m.driverPetrolWk);

    var v = $('verdict');
    if (m.driverBetterOff) {
      v.style.background = 'var(--leaf)'; v.style.color = '#1E5B2A';
      v.innerHTML = 'The rider is <b>' + R(m.driverSavingWk) + ' a week better off</b> on electric, ' +
        'and you collect ' + R(m.rentalGap) + ' more rental. You could go as high as <b>' +
        R(m.breakEvenRental) + '</b> before the rider stops gaining.';
      $('verdictH').textContent = 'The deal works';
    } else {
      v.style.background = 'var(--warn)'; v.style.color = 'var(--warn-ink)';
      v.innerHTML = 'At this petrol price the rider would be <b>' + R(Math.abs(m.driverSavingWk)) +
        ' a week worse off</b> on electric. Drop the electric rental to <b>' + R(m.breakEvenRental) +
        '</b> or below to make the switch worth their while.';
      $('verdictH').textContent = 'The deal does not work yet';
    }
    $('erentalVal').textContent = R(m.inputs.electricRental);
    $('erentalHint').innerHTML = 'a week, set by ScootHero — break-even is <b>' + R(m.breakEvenRental) + '</b>';

    $('resTitle').textContent = m.inputs.bikes + (m.inputs.bikes === 1 ? ' bike' : ' bikes');
    $('kWk').textContent = R(m.operatorUpliftWk);
    $('kMo').textContent = R(m.operatorUpliftMonth);
    $('kRider').textContent = R(m.driverSavingWk);
    $('kBreak').textContent = R(m.breakEvenRental);
    $('roiVal').textContent = R(m.operatorUpliftYear);

    $('b1a').textContent = R(m.petrolFuelWk);
    $('b1b').textContent = '\u2212' + R(m.electricEnergyWk);
    $('b1c').textContent = R(m.energySaving);
    $('b1d').textContent = '\u2212' + R(m.rentalGap);
    $('b1e').textContent = R(m.driverSavingWk);

    $('b2a').textContent = m.inputs.bikes;
    $('b2b').textContent = R(m.operatorUpliftWk);
    $('b2c').textContent = R(m.operatorUpliftMonth);
    $('b2d').textContent = R(m.operatorUpliftYear);
    $('b2e').textContent = R(m.driverSavingYear);

    if (window.parent !== window) {
      window.parent.postMessage({ type: 'setHeight', height: document.body.scrollHeight + 24 }, '*');
    }
  }

  $('minus').addEventListener('click', function () { $('bikes').value = Math.max(1, (parseInt($('bikes').value, 10) || 1) - 1); render(); });
  $('plus').addEventListener('click', function () { $('bikes').value = Math.min(200, (parseInt($('bikes').value, 10) || 1) + 1); render(); });
  ['bikes', 'fuel', 'prental', 'elec'].forEach(function (id) { $(id).addEventListener('input', render); });
  dayInputs.forEach(function (el) { el.addEventListener('input', render); });

  // ---- capture ----
  var API = (window.SH_API || '');
  function msg(t, k) { var e = $('capMsg'); e.textContent = t; e.className = 'cap-msg ' + k; }

  $('capSend').addEventListener('click', function () {
    var email = $('cEmail').value.trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { msg('Please enter a valid email address.', 'bad'); $('cEmail').focus(); return; }
    if (!$('cConsent').checked) { msg('Please tick the box so we may email and store this.', 'bad'); return; }
    var btn = this, orig = btn.textContent;
    btn.disabled = true; btn.textContent = 'Sending\u2026'; msg('Building your proposal\u2026', 'ok');
    fetch(API + '/api/calculation', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        kind: 'savings',
        contact: { name: $('cName').value, email: email, company: $('cCompany').value, phone: $('cPhone').value },
        inputs: raw(), consent: true, website: $('cWebsite').value, source: location.href
      })
    })
      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }); })
      .then(function (r) {
        if (r.ok && r.body.ok) {
          msg('Sent. Your proposal is on its way to ' + email + ' \u2014 reference ' + (r.body.reference || '') + '.', 'ok');
          btn.textContent = 'Sent';
        } else { msg((r.body && r.body.error) || 'We could not send that.', 'bad'); btn.disabled = false; btn.textContent = orig; }
      })
      .catch(function () { msg('No connection. Please check your network and try again.', 'bad'); btn.disabled = false; btn.textContent = orig; });
  });

  $('capDownload').addEventListener('click', function () {
    var btn = this, orig = btn.textContent;
    btn.disabled = true; btn.textContent = 'Preparing\u2026';
    fetch(API + '/api/preview.pdf', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ kind: 'savings', inputs: raw() })
    })
      .then(function (r) { if (!r.ok) throw new Error(); return r.blob(); })
      .then(function (blob) {
        var url = URL.createObjectURL(blob), a = document.createElement('a');
        a.href = url; a.download = 'ScootHero-driver-savings.pdf';
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(function () { URL.revokeObjectURL(url); }, 4000);
        msg('Downloaded. Nothing was stored or sent.', 'ok');
      })
      .catch(function () { msg('Could not build the PDF just now.', 'bad'); })
      .finally(function () { btn.disabled = false; btn.textContent = orig; });
  });

  render();
  window.addEventListener('load', render);
})();
</script>

